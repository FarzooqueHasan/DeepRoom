{
  "name": "StudyBuddyPair",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string"
    },
    "user1_id": {
      "type": "string"
    },
    "user1_name": {
      "type": "string"
    },
    "user2_id": {
      "type": "string"
    },
    "user2_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "completed"
      ],
      "default": "pending"
    },
    "session_goal": {
      "type": "string"
    },
    "target_minutes": {
      "type": "number"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "room_id",
    "user1_id",
    "user2_id"
  ]
}